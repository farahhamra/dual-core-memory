{
  "name": "antigravity-vector-memory",
  "version": "1.0.0",
  "description": "Local vector-based memory for Antigravity agents powered by Ollama and LanceDB",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "memory": "./bin/cli.js",
    "memory-search": "./src/search.js",
    "memory-save": "./src/save.js",
    "memory-update": "./src/update.js",
    "memory-delete": "./src/delete.js"
  },
  "scripts": {
    "cli": "node bin/cli.js",
    "stats": "node bin/cli.js stats",
    "search": "node bin/cli.js search",
